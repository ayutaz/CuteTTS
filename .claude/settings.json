{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(vastai:*)",
      "Bash(.venv/Scripts/python.exe:*)",
      "Bash(python:*)",
      "Bash(tar:*)",
      "Bash(cp:*)",
      "Bash(mkdir:*)",
      "Bash(ls:*)",
      "Bash(df:*)",
      "Bash(wc:*)",
      "Bash(printf:*)",
      "Bash(for:*)",
      "Bash(read:*)",
      "Write",
      "Edit",
      "Agent"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  }
}
